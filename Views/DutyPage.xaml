<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.DutyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:services="clr-namespace:FacultyMonitoring.Services"
             x:DataType="vm:DutyViewModel"
             Title="Duty">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="READS Scholars and their vacant times" Style="{StaticResource SectionTitle}" />
                <Label Text="Each READS Scholar enters their own vacant times on their Duty tab. They monitor the classes of the school you assign on the Assign tab. This list is read-only." FontSize="13" TextColor="{StaticResource Gray600}" />
                <Label Text="There are no READS Scholars yet." FontSize="13" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNone}" />
                <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding Scholars}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:ScholarDutyRow">
                      <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Assignment}" FontSize="12" TextColor="{StaticResource ForestMid}" />
                        <Label Text="{Binding VacantSummary}" FontSize="12" TextColor="{StaticResource Gray600}" />
                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
