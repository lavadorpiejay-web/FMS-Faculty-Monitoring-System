<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.DutyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:services="clr-namespace:FacultyMonitoring.Services"
             x:DataType="vm:DutyViewModel"
             Title="Duty">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="READS Scholars and their vacant times" Style="{StaticResource SectionTitle}" />
                <Label Text="Each READS Scholar enters their own vacant times on their Duty tab. They monitor the classes of the school you assign on the Assign tab. This list is read-only." FontSize="13" TextColor="{StaticResource Gray600}" />
                <Label Text="There are no READS Scholars yet." FontSize="13" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNone}" />
                <Label Text="Tap a READS Scholar's name to show or hide their vacant schedule." FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasScholars}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Scholars}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="services:ScholarDutyRow">
                      <Border BackgroundColor="{StaticResource Ivory}" Stroke="{StaticResource Gray200}" StrokeThickness="1" Padding="14,12">
                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding Arrow}" FontSize="12" TextColor="{StaticResource ForestMid}" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                              <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                              <Label Text="{Binding Assignment}" FontSize="12" TextColor="{StaticResource ForestMid}" />
                              <Label Text="{Binding CountText}" FontSize="12" TextColor="{StaticResource Gray600}" />
                            </VerticalStackLayout>
                            <Grid.GestureRecognizers>
                              <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Grid.GestureRecognizers>
                          </Grid>
                          <VerticalStackLayout Spacing="6" IsVisible="{Binding IsExpanded}">
                            <Label Text="{Binding VacantSummary}" FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNoBlocks}" />
                            <controls:WeeklyTimetable Blocks="{Binding Blocks}" Compact="True" IsVisible="{Binding HasBlocks}" Margin="0,4,0,0" />
                          </VerticalStackLayout>
                        </VerticalStackLayout>
                      </Border>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
