<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.FacultySchedulePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:FacultyScheduleViewModel"
             Title="My schedule">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="My classes" Style="{StaticResource SectionTitle}" />
                <Label Text="Your encoded schedule is what READS checkers monitor." FontSize="13" TextColor="{StaticResource Gray600}" />
                <Label Text="You have no classes encoded yet." FontSize="13" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNoClasses}" />
                <controls:WeeklyTimetable Blocks="{Binding Timetable}" IsVisible="{Binding HasClasses}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                  <Label Grid.Column="0" Text="{Binding RequestArrow}" FontSize="12" TextColor="{StaticResource ForestMid}" VerticalOptions="Center" />
                  <Label Grid.Column="1" Text="Request a change" Style="{StaticResource SectionTitle}" />
                  <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleRequestCommand}" />
                  </Grid.GestureRecognizers>
                </Grid>
                <Label Text="Tap to show the request form." FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding IsRequestClosed}" />
                <controls:Banners />
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsRequestOpen}">
                <Label Text="Schedule changes go to your Chairperson. Room changes go to the Dean of your school, then IMS Personnel. Rooms are limited to the building your school is situated in." FontSize="13" TextColor="{StaticResource Gray600}" />
                <controls:LabeledPicker Caption="Class" Title="Choose a class" ItemsSource="{Binding ClassLabels}" SelectedItem="{Binding SelectedClass, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Type of request" Title="Choose type" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind, Mode=TwoWay}" />
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsScheduleChange}">
                  <controls:LabeledPicker Caption="New day" Title="No change" ItemsSource="{Binding DayChoices}" SelectedItem="{Binding NewDay, Mode=TwoWay}" />
                  <controls:LabeledPicker Caption="New start time" Title="No change" ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding NewStart, Mode=TwoWay}" />
                  <controls:LabeledPicker Caption="New end time" Title="No change" ItemsSource="{Binding TimeChoices}" SelectedItem="{Binding NewEnd, Mode=TwoWay}" />
                  <controls:LabeledPicker Caption="New subject" Title="No change" ItemsSource="{Binding SubjectChoices}" SelectedItem="{Binding NewSubject, Mode=TwoWay}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="12" IsVisible="{Binding IsRoomChange}">
                  <controls:LabeledPicker Caption="New classroom" Title="Choose classroom" ItemsSource="{Binding RoomLabels}" SelectedItem="{Binding NewRoom, Mode=TwoWay}" />
                </VerticalStackLayout>
                <controls:LabeledEntry Caption="Reason" Placeholder="Why is the change needed?" Text="{Binding Reason, Mode=TwoWay}" />
                <Button Text="Send request" Command="{Binding SubmitCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="My requests" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding RequestRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                        <Label Text="{Binding Extra}" FontSize="12" TextColor="{StaticResource ForestMid}" />

                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
