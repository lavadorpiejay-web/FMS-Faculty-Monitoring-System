<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.SchedulesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:SchedulesViewModel"
             Title="Schedules">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Encode a faculty schedule" Style="{StaticResource SectionTitle}" />
                <Label Text="The initial schedule is the baseline READS checkers monitor. Two classes cannot share a room or a Faculty member at the same time." FontSize="13" TextColor="{StaticResource Gray600}" />
                <controls:LabeledPicker Caption="School" Title="Choose school" ItemsSource="{Binding SchoolChoices}" SelectedItem="{Binding SelectedSchool, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Department" Title="Choose school first, then department" ItemsSource="{Binding DepartmentChoices}" SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Faculty member" Title="Choose department first, then faculty" ItemsSource="{Binding FacultyLabels}" SelectedItem="{Binding SelectedFaculty, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Subject" Title="Choose faculty first, then subject" ItemsSource="{Binding SubjectLabels}" SelectedItem="{Binding SelectedSubject, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Building" Title="Choose building" ItemsSource="{Binding BuildingChoices}" SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Floor" Title="Choose building first, then floor" ItemsSource="{Binding FloorChoices}" SelectedItem="{Binding SelectedFloor, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Room" Title="Choose floor first, then room" ItemsSource="{Binding RoomChoices}" SelectedItem="{Binding SelectedRoom, Mode=TwoWay}" />
                <VerticalStackLayout Spacing="4">
                  <Label Text="Class days (tick every day the class meets)" FontSize="12" TextColor="{StaticResource Gray600}" />
                  <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:DayChoice">
                        <HorizontalStackLayout Spacing="2" Margin="0,0,12,0">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          <Label Text="{Binding ShortName}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                </VerticalStackLayout>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <Label Grid.Column="0" Text="Same time for every day" VerticalOptions="Center" />
                  <Switch Grid.Column="1" IsToggled="{Binding SameTime, Mode=TwoWay}" />
                </Grid>
                <controls:LabeledPicker Caption="Start time" Title="Choose start" ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedStart, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="End time" Title="Choose end" ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedEnd, Mode=TwoWay}" />
                <VerticalStackLayout Spacing="10" IsVisible="{Binding DifferentTimes}">
                  <Label Text="Times for each ticked day (they start from the time above)" FontSize="12" TextColor="{StaticResource Gray600}" />
                  <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding CustomDays}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:DayChoice">
                        <VerticalStackLayout Spacing="4">
                          <Label Text="{Binding Name}" FontAttributes="Bold" />
                          <controls:LabeledPicker Caption="Start" Title="Choose start" SelectedItem="{Binding Start, Mode=TwoWay}"
                                                  ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:SchedulesViewModel}}, Path=Times}" />
                          <controls:LabeledPicker Caption="End" Title="Choose end" SelectedItem="{Binding End, Mode=TwoWay}"
                                                  ItemsSource="{Binding Source={RelativeSource AncestorType={x:Type vm:SchedulesViewModel}}, Path=Times}" />
                        </VerticalStackLayout>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </VerticalStackLayout>
                </VerticalStackLayout>
                <controls:Banners />
                <Button Text="Save schedule" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Encoded schedules" Style="{StaticResource SectionTitle}" />
                <Label Text="Grouped by school, then department. Tap a heading to show or hide it. Remove asks whether to delete only that class, the same subject, the same day, the same time, or the ones you choose." FontSize="12" TextColor="{StaticResource Gray600}" />
                <Label Text="No schedules encoded yet." FontSize="13" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNoRows}" />
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Schools}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SchoolGroup">
                      <Border Style="{StaticResource Card}" Padding="12" BackgroundColor="{StaticResource Ivory}">
                        <VerticalStackLayout Spacing="10">
                          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding Arrow}" FontSize="12" TextColor="{StaticResource ForestMid}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="{StaticResource DeepGreen}" />
                            <Label Grid.Column="2" Text="{Binding CountText}" FontSize="12" TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                              <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                            </Grid.GestureRecognizers>
                          </Grid>
                          <VerticalStackLayout Spacing="10" IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding Departments}">
                            <BindableLayout.ItemTemplate>
                              <DataTemplate x:DataType="models:RowGroup">
                                <Border Style="{StaticResource Card}" Padding="10" BackgroundColor="White">
                                  <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                      <Label Grid.Column="0" Text="{Binding Arrow}" FontSize="11" TextColor="{StaticResource ForestMid}" VerticalOptions="Center" />
                                      <Label Grid.Column="1" Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                      <Label Grid.Column="2" Text="{Binding CountText}" FontSize="12" TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                                      <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                      </Grid.GestureRecognizers>
                                    </Grid>
                                    <VerticalStackLayout Spacing="14" IsVisible="{Binding IsExpanded}" BindableLayout.ItemsSource="{Binding Rows}">
                                      <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ListRow">
                                          <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                            <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                            <Button Text="Remove" HeightRequest="40" FontSize="13" Style="{StaticResource OutlineButton}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SchedulesViewModel}}, Path=RemoveCommand}"
                                                    CommandParameter="{Binding .}" />
                                          </VerticalStackLayout>
                                        </DataTemplate>
                                      </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                  </VerticalStackLayout>
                                </Border>
                              </DataTemplate>
                            </BindableLayout.ItemTemplate>
                          </VerticalStackLayout>
                        </VerticalStackLayout>
                      </Border>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
