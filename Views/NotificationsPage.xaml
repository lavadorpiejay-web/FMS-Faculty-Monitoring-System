<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.NotificationsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:NotificationsViewModel"
             Title="Notifications">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Label Text="{Binding Summary}" FontSize="13" TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Mark all as read" HeightRequest="38" FontSize="12"
                        Style="{StaticResource OutlineButton}" IsVisible="{Binding HasUnread}"
                        Command="{Binding MarkAllReadCommand}" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="20" IsVisible="{Binding IsEmpty}">
                <Label Text="No notifications yet." FontSize="14" TextColor="{StaticResource Gray600}" />
            </Border>

            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Items}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:NotificationRow">
                        <Border Style="{StaticResource Card}" Padding="14" BackgroundColor="{Binding BackgroundColor}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Label Grid.Column="0" Text="●" FontSize="12" TextColor="#E0301E" VerticalOptions="Start"
                                       Margin="0,3,0,0" IsVisible="{Binding IsUnread}" />
                                <Label Grid.Column="0" Text="○" FontSize="12" TextColor="{StaticResource Gray200}" VerticalOptions="Start"
                                       Margin="0,3,0,0" IsVisible="{Binding IsRead}" />
                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Message}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding TimeText}" FontSize="11" TextColor="{StaticResource ForestMid}" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotificationsViewModel}}, Path=OpenCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
