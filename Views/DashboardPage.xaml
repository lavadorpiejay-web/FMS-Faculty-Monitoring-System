<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             x:DataType="vm:DashboardViewModel"
             Title="Home">
    <controls:DraggableScrollView>
        <VerticalStackLayout Spacing="0">

            <VerticalStackLayout BackgroundColor="{StaticResource DeepGreen}" Padding="24,24,24,28" Spacing="4">
                <Label Text="{Binding RoleName}" TextTransform="Uppercase" CharacterSpacing="2"
                       FontSize="12" FontAttributes="Bold" TextColor="{StaticResource Gold}" />
                <Label Text="{Binding Greeting}" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label Text="{Binding Department}" FontSize="14" TextColor="#CFE3D6" />
            </VerticalStackLayout>
            <BoxView HeightRequest="4" Color="{StaticResource Gold}" />

            <VerticalStackLayout Padding="20" Spacing="16">
                <Border Style="{StaticResource Card}" Padding="20">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding TodayHeading}" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding TodaySummary}" FontSize="13" TextColor="{StaticResource Gray600}" />
                        <Label Text="Nothing to check today." FontSize="14" TextColor="{StaticResource Gray600}"
                               IsVisible="{Binding HasNoClassesToday}" />
                        <VerticalStackLayout Spacing="16" BindableLayout.ItemsSource="{Binding TodayRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AttendanceCardRow">
                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="2">
                                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                        <Label Grid.Column="1" Text="{Binding StatusText}" FontAttributes="Bold" FontSize="16"
                                               TextColor="{Binding StatusColor}" VerticalOptions="Start" />
                                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Detail}" FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                        <Label Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding State}" FontSize="12"
                                               TextColor="{StaticResource ForestMid}" />
                                        <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding Checks}" FontSize="12"
                                               TextColor="{StaticResource Gray600}" IsVisible="{Binding HasChecks}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
