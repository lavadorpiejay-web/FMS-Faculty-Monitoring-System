<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.RoomsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:RoomsViewModel"
             Title="Classrooms">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Add a classroom" Style="{StaticResource SectionTitle}" />
                <Label Text="The Dean of the owning school approves room changes into this room." FontSize="13" TextColor="{StaticResource Gray600}" />
                <controls:LabeledPicker Caption="Campus" Title="Choose campus" ItemsSource="{Binding Campuses}" SelectedItem="{Binding SelectedCampus, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="School that owns the room" Title="Choose school" ItemsSource="{Binding Schools}" SelectedItem="{Binding SelectedSchool, Mode=TwoWay}" />
                <controls:LabeledEntry Caption="Building" Placeholder="e.g. Main" Text="{Binding Building, Mode=TwoWay}" />
                <controls:LabeledEntry Caption="Floor" Placeholder="e.g. 2" Text="{Binding Floor, Mode=TwoWay}" />
                <controls:LabeledEntry Caption="Room number" Placeholder="e.g. 202" Text="{Binding RoomNo, Mode=TwoWay}" />
                <controls:LabeledEntry Caption="Capacity" Placeholder="e.g. 40" Text="{Binding Capacity, Mode=TwoWay}" />
                <controls:Banners />
                <Button Text="Add classroom" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Classrooms" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Rows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
