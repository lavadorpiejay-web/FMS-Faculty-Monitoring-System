<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.RoomsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:RoomsViewModel"
             Title="Classrooms">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Room availability" Style="{StaticResource SectionTitle}" />
                <Label Text="Main Campus classrooms are fixed. Choose a building, floor, day and time to see which rooms are occupied or vacant. To use a room, add a schedule on the Schedules tab." FontSize="13" TextColor="{StaticResource Gray600}" />
                <controls:LabeledPicker Caption="Building" Title="Choose building" ItemsSource="{Binding BuildingChoices}" SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Floor (optional)" Title="Choose building first, then floor" ItemsSource="{Binding FloorChoices}" SelectedItem="{Binding SelectedFloor, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="Day" Title="Choose day" ItemsSource="{Binding Days}" SelectedItem="{Binding SelectedDay, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="From" Title="Choose start" ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedStart, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="To" Title="Choose end" ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedEnd, Mode=TwoWay}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20" IsVisible="{Binding FloorSelected}">
              <VerticalStackLayout Spacing="12">
                <Label Text="School assigned to this floor" Style="{StaticResource SectionTitle}" />
                <Label Text="The Dean of this school approves room changes into this floor's rooms." FontSize="13" TextColor="{StaticResource Gray600}" />
                <controls:LabeledPicker Caption="School" Title="Choose school" ItemsSource="{Binding Schools}" SelectedItem="{Binding FloorSchool, Mode=TwoWay}" />
                <controls:Banners />
                <Button Text="Save assigned school" Command="{Binding SaveFloorSchoolCommand}" IsEnabled="{Binding IsNotBusy}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Rooms" Style="{StaticResource SectionTitle}" />
                <Label Text="{Binding Summary}" FontSize="13" TextColor="{StaticResource Gray600}" />
                <Label Text="Choose a building to list its rooms." FontSize="13" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNoRooms}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding RoomRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
