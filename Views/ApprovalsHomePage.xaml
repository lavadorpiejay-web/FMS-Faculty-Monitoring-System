<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.ApprovalsHomePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:ApprovalsHomeViewModel"
             Title="Home">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
                <Label Text="{Binding Welcome}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                <Label Text="{Binding Summary}" FontSize="13" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>

            <controls:Banners />

            <!-- Accounts waiting for approval -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding AccountsHeading}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding AccountsExplanation}" FontSize="12" TextColor="{StaticResource Gray600}" />
                    <Label Text="Nobody is waiting for approval." FontSize="14" TextColor="{StaticResource Gray600}"
                           IsVisible="{Binding AccountsEmpty}" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Accounts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PendingApproval">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Id, StringFormat='ID: {0}'}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Email}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Button Text="Approve" HeightRequest="40" FontSize="13"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=ApproveAccountCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Decline" HeightRequest="40" FontSize="13" Style="{StaticResource OutlineButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=DeclineAccountCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Change requests (Chairperson, Dean) / approved changes to apply (IMS Personnel) -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="{Binding RequestsHeading}" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding RequestsExplanation}" FontSize="12" TextColor="{StaticResource Gray600}" />
                    <Label Text="{Binding PendingText}" FontSize="12" TextColor="{StaticResource ForestMid}"
                           IsVisible="{Binding HasPendingText}" />
                    <Label Text="{Binding RequestsEmptyText}" FontSize="14" TextColor="{StaticResource Gray600}"
                           IsVisible="{Binding RequestsEmpty}" />
                    <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Requests}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ListRow">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    <Label Text="{Binding Extra}" FontSize="12" TextColor="{StaticResource ForestMid}" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8"
                                          IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=IsApprover}">
                                        <Button Text="Approve" HeightRequest="40" FontSize="13"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=ApproveRequestCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="1" Text="Decline" HeightRequest="40" FontSize="13" Style="{StaticResource OutlineButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=DeclineRequestCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                    <Button Text="Apply to schedule" HeightRequest="40" FontSize="13"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=IsIms}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ApprovalsHomeViewModel}}, Path=ApplyChangeCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
