<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.ForgotPasswordPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             x:DataType="vm:ForgotPasswordViewModel"
             Title="Forgot password">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">

                    <!-- Step 1: the account email -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding IsStepOne}">
                        <Label Text="Reset your password" Style="{StaticResource SectionTitle}" />
                        <Label Text="Enter the email address of your account. We will send you a 6-digit code."
                               FontSize="14" TextColor="{StaticResource Gray600}" />
                        <Label Text="Email address" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Entry Text="{Binding Email}" Placeholder="name@example.com" Keyboard="Email"
                                   ReturnType="Go" ReturnCommand="{Binding SendCodeCommand}" />
                        </Border>
                        <Button Text="Send code" Command="{Binding SendCodeCommand}" IsEnabled="{Binding IsNotBusy}" />
                    </VerticalStackLayout>

                    <!-- Step 2: the code and the new password -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding CodeSent}">
                        <Label Text="Enter the code" Style="{StaticResource SectionTitle}" />
                        <Label Text="{Binding Info}" IsVisible="{Binding HasInfo}" FontSize="14"
                               TextColor="{StaticResource Gray600}" />

                        <Label Text="6-digit code" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Entry Text="{Binding Code}" Placeholder="123456" Keyboard="Numeric" MaxLength="6" />
                        </Border>

                        <Label Text="New password" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <Border Stroke="{StaticResource Gray200}" Padding="12,0,4,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Text="{Binding NewPassword}" Placeholder="Mixed characters, min. 8"
                                       IsPassword="{Binding IsPasswordHidden}" ReturnType="Next" />
                                <Button Grid.Column="1" Text="{Binding ShowHideText}"
                                        Command="{Binding TogglePasswordCommand}"
                                        Style="{StaticResource TextButton}" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding PasswordRule}" FontSize="12" TextColor="{StaticResource Gray600}" />

                        <Label Text="Confirm new password" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <Border Stroke="{StaticResource Gray200}" Padding="12,0,4,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Text="{Binding ConfirmPassword}" Placeholder="Re-enter the new password"
                                       IsPassword="{Binding IsConfirmPasswordHidden}" ReturnType="Go"
                                       ReturnCommand="{Binding ResetCommand}" />
                                <Button Grid.Column="1" Text="{Binding ConfirmShowHideText}"
                                        Command="{Binding ToggleConfirmPasswordCommand}"
                                        Style="{StaticResource TextButton}" />
                            </Grid>
                        </Border>
                        <Label Text="{Binding MatchText}" IsVisible="{Binding HasMatchText}" FontSize="12"
                               TextColor="{StaticResource ErrorRed}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding PasswordsMatch}" Value="True">
                                    <Setter Property="TextColor" Value="{StaticResource ForestMid}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>

                        <Button Text="Change password" Command="{Binding ResetCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <Button Text="Send a new code or use another email" Command="{Binding ChangeEmailCommand}"
                                Style="{StaticResource OutlineButton}" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorRed}" FontSize="13" />
                    </Border>
                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource DeepGreen}" HeightRequest="24" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
