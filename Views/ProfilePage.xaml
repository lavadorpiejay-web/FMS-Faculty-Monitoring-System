<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             x:DataType="vm:ProfileViewModel"
             Title="Profile">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            <controls:Banners />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="14" ColumnSpacing="8">
                    <Label Text="Name" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Column="1" Text="{Binding FullName}" FontAttributes="Bold" />

                    <Label Grid.Row="1" Text="ID" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SisId}" />

                    <Label Grid.Row="2" Text="Role" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding RoleName}" />

                    <Label Grid.Row="3" Text="Assigned to" TextColor="{StaticResource Gray600}" />
                    <Label Grid.Row="3" Grid.Column="1" Text="{Binding Department}" />

                    <Label Grid.Row="4" Text="Reports to" TextColor="{StaticResource Gray600}"
                           IsVisible="{Binding HasReportsTo}" />
                    <Label Grid.Row="4" Grid.Column="1" Text="{Binding ReportsTo}"
                           IsVisible="{Binding HasReportsTo}" />

                    <Label Grid.Row="5" Text="Oversees" TextColor="{StaticResource Gray600}"
                           IsVisible="{Binding HasOversees}" />
                    <Label Grid.Row="5" Grid.Column="1" Text="{Binding Oversees}"
                           IsVisible="{Binding HasOversees}" />
                </Grid>
            </Border>

            <!-- Resignation (Faculty, Chairperson, Dean, READS) -->
            <Border Style="{StaticResource Card}" Padding="20" IsVisible="{Binding CanResign}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Resignation" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding ResignationRoute}" FontSize="12" TextColor="{StaticResource Gray600}" />

                    <!-- Where an open resignation is -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasOpenResignation}">
                        <Label Text="Your resignation is waiting for a decision:" FontAttributes="Bold" FontSize="14" />
                        <Label Text="{Binding ResignationTrail}" FontSize="13" />
                        <Button Text="Withdraw" Style="{StaticResource OutlineButton}" HeightRequest="40" FontSize="13"
                                Command="{Binding WithdrawResignationCommand}" />
                    </VerticalStackLayout>

                    <!-- A declined one: the reason and who declined it -->
                    <Label Text="{Binding ResignationDeclined}" FontSize="13" TextColor="{StaticResource ErrorRed}"
                           IsVisible="{Binding HasDeclined}" />

                    <!-- New resignation -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding ShowResignForm}">
                        <Label Text="Reason for your resignation" FontSize="13" FontAttributes="Bold" />
                        <Border StrokeThickness="1" Stroke="{StaticResource Gray600}" Padding="8,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                            <Editor Text="{Binding ResignationReason}" Placeholder="State your reason"
                                    TextColor="{StaticResource InkDark}" PlaceholderColor="#8FA096" BackgroundColor="Transparent"
                                    AutoSize="TextChanges" MinimumHeightRequest="80" MaxLength="{Binding ReasonMaxLength}" />
                        </Border>
                        <Button Text="Submit resignation" HeightRequest="44"
                                Command="{Binding SubmitResignationCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Sign out" Command="{Binding SignOutCommand}" />
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
