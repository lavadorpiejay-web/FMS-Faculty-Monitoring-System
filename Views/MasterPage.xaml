<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.MasterPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:MasterViewModel"
             Title="Master">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
              <Label Text="Master schedule" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
              <Label Text="Faculty classes alongside READS Scholars: assigned school and vacant times." FontSize="13" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="{Binding ScheduleHeading}" Style="{StaticResource SectionTitle}" />
                <controls:LabeledPicker Caption="Department" Title="All departments" ItemsSource="{Binding DepartmentFilters}" SelectedItem="{Binding SelectedDepartment, Mode=TwoWay}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding ScheduleRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                        <Label Text="{Binding Extra}" FontSize="12" TextColor="{StaticResource ForestMid}" />

                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="READS duty and monitoring assignments" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding DutyRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Irregularity reports" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding IrregularityRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Recent attendance entries" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding LogRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Change history" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding AuditRows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
