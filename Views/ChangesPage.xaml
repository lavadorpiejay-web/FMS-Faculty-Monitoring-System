<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.ChangesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:ChangesViewModel"
             Title="Changes">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
              <Label Text="Approved changes" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
              <Label Text="Faculty requests approved by a Chairperson or Dean. Apply them to update the master schedule." FontSize="13" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>
            <Label Text="{Binding PendingText}" FontSize="13" TextColor="{StaticResource Gray600}" />
            <controls:Banners />
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="{Binding Heading}" Style="{StaticResource SectionTitle}" />
                <Label Text="No approved changes are waiting." FontSize="14" TextColor="{StaticResource Gray600}" IsVisible="{Binding IsEmpty}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Rows}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                        <Label Text="{Binding Extra}" FontSize="12" TextColor="{StaticResource ForestMid}" />
                        <Grid ColumnDefinitions="*" ColumnSpacing="8">
                          <Button Text="Apply to schedule" HeightRequest="40" FontSize="13"
                                  Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ChangesViewModel}}, Path=ApplyCommand}"
                                  CommandParameter="{Binding .}" />
                        </Grid>
                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
