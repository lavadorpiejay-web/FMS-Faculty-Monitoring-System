<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.DirectoryPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:DirectoryViewModel"
             Title="Directory">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Shown until IMS Personnel assigns this Scholar to a school and department. -->
            <Border Style="{StaticResource Card}" BackgroundColor="{StaticResource GoldSoft}"
                    Stroke="{StaticResource Gold}" IsVisible="{Binding IsNotAssigned}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="No department assigned yet" Style="{StaticResource SectionTitle}" />
                    <Label Text="IMS Personnel has not assigned you to a school and department. Once they do, the people in that department will appear here."
                           FontSize="14" TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Spacing="16" IsVisible="{Binding IsAssigned}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Your assigned department" FontSize="12" TextColor="{StaticResource Gray600}" />
                    <Label Text="{Binding Department}" FontSize="20" FontAttributes="Bold"
                           TextColor="{StaticResource DeepGreen}" />
                    <Label Text="{Binding School}" FontSize="14" TextColor="{StaticResource Gray600}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Dean" Style="{StaticResource SectionTitle}" />
                        <Label Text="None registered yet." FontSize="13" TextColor="{StaticResource Gray600}"
                               IsVisible="{Binding DeansEmpty}" />
                        <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Deans}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DirectoryEntry">
                                    <VerticalStackLayout Spacing="1">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="{Binding DepartmentsArrow}" FontSize="12"
                                   TextColor="{StaticResource ForestMid}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="Departments" Style="{StaticResource SectionTitle}" />
                            <Label Grid.Column="2" Text="{Binding DepartmentsCountText}" FontSize="12"
                                   TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleDepartmentsCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>

                        <VerticalStackLayout Spacing="14" IsVisible="{Binding DepartmentsOpen}"
                                             BindableLayout.ItemsSource="{Binding Departments}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:DirectoryDepartment">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding Department}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource ForestMid}" />

                                        <!-- Each chairperson: tap the name to show that department's faculty. -->
                                        <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Chairpersons}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:ChairpersonNode">
                                                    <Border Style="{StaticResource Card}" Padding="12" BackgroundColor="{StaticResource Ivory}">
                                                        <VerticalStackLayout Spacing="8">
                                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                                                <Label Grid.Column="0" Text="{Binding Arrow}" FontSize="11"
                                                                       TextColor="{StaticResource ForestMid}" VerticalOptions="Center" />
                                                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                                                    <Label Text="Chairperson" FontSize="12" TextColor="{StaticResource Gray600}" />
                                                                </VerticalStackLayout>
                                                                <Label Grid.Column="2" Text="{Binding CountText}" FontSize="12"
                                                                       TextColor="{StaticResource Gray600}" VerticalOptions="Center" />
                                                                <Grid.GestureRecognizers>
                                                                    <TapGestureRecognizer Command="{Binding ToggleCommand}" />
                                                                </Grid.GestureRecognizers>
                                                            </Grid>
                                                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsExpanded}">
                                                                <Label Text="No faculty registered yet." FontSize="13"
                                                                       TextColor="{StaticResource Gray600}" IsVisible="{Binding NoFaculty}" />
                                                                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Faculty}">
                                                                    <BindableLayout.ItemTemplate>
                                                                        <DataTemplate x:DataType="models:DirectoryEntry">
                                                                            <Label Text="{Binding Name}" FontSize="14" Margin="21,0,0,0" />
                                                                        </DataTemplate>
                                                                    </BindableLayout.ItemTemplate>
                                                                </VerticalStackLayout>
                                                            </VerticalStackLayout>
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <!-- No chairperson registered: show the faculty directly so nobody is hidden. -->
                                        <VerticalStackLayout Spacing="6" IsVisible="{Binding NoChairperson}">
                                            <Label Text="No chairperson registered yet." FontSize="13" TextColor="{StaticResource Gray600}" />
                                            <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Faculty}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DirectoryEntry">
                                                        <Label Text="{Binding Name}" FontSize="14" Margin="21,0,0,0" />
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Label Text="Tap Departments to show the chairpersons, then tap a chairperson to show that department's faculty. Read-only view."
                       FontSize="12" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
