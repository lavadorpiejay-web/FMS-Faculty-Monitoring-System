<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.MyDutyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:MyDutyViewModel"
             Title="My duty">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <VerticalStackLayout Spacing="4">
              <Label Text="Duty dashboard" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
              <Label Text="{Binding ClockText}" FontSize="13" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>
            <Label Text="You have no duty assigned yet. IMS Personnel assign your duty schedule and monitoring area." FontSize="14" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNoDuty}" />
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="On duty now" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Current}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Upcoming" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Upcoming}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Completed today" Style="{StaticResource SectionTitle}" />
                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Completed}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" />
                        <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />


                      </VerticalStackLayout>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
