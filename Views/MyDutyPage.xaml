<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.MyDutyPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:MyDutyViewModel"
             Title="My vacant times">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="Enter my vacant times" Style="{StaticResource SectionTitle}" />
                <Label Text="Your vacant times are your duty hours. Tick every day that has the same free time, choose the start and end, then save." FontSize="13" TextColor="{StaticResource Gray600}" />
                <VerticalStackLayout Spacing="4">
                  <Label Text="Days (tick all that apply)" FontSize="12" TextColor="{StaticResource Gray600}" />
                  <FlexLayout Wrap="Wrap" JustifyContent="Start" BindableLayout.ItemsSource="{Binding Days}">
                    <BindableLayout.ItemTemplate>
                      <DataTemplate x:DataType="models:DayChoice">
                        <HorizontalStackLayout Spacing="2" Margin="0,0,12,0">
                          <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                          <Label Text="{Binding ShortName}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                      </DataTemplate>
                    </BindableLayout.ItemTemplate>
                  </FlexLayout>
                </VerticalStackLayout>
                <controls:LabeledPicker Caption="From" Title="Choose start" ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedStart, Mode=TwoWay}" />
                <controls:LabeledPicker Caption="To" Title="Choose end" ItemsSource="{Binding Times}" SelectedItem="{Binding SelectedEnd, Mode=TwoWay}" />
                <controls:Banners />
                <Button Text="Save vacant times" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
              </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource Card}" Padding="20">
              <VerticalStackLayout Spacing="12">
                <Label Text="My vacant times" Style="{StaticResource SectionTitle}" />
                <Label Text="You have not entered any vacant times yet." FontSize="13" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNoSlots}" />
                <Grid ColumnDefinitions="2*,2*,2*,*" ColumnSpacing="6" IsVisible="{Binding HasSlots}">
                  <Label Grid.Column="0" Text="Day" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Gray600}" />
                  <Label Grid.Column="1" Text="From" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Gray600}" />
                  <Label Grid.Column="2" Text="To" FontAttributes="Bold" FontSize="12" TextColor="{StaticResource Gray600}" />
                </Grid>
                <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Slots}">
                  <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:ListRow">
                      <Grid ColumnDefinitions="2*,2*,2*,*" ColumnSpacing="6">
                        <Label Grid.Column="0" Text="{Binding Title}" FontSize="14" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding Detail}" FontSize="14" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding Extra}" FontSize="14" VerticalOptions="Center" />
                        <Button Grid.Column="3" Text="X" HeightRequest="36" WidthRequest="40" Padding="0" FontSize="13" Style="{StaticResource OutlineButton}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MyDutyViewModel}}, Path=RemoveCommand}"
                                CommandParameter="{Binding .}" />
                      </Grid>
                    </DataTemplate>
                  </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
              </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
