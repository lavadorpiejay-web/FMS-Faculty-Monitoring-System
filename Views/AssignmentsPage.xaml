<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.AssignmentsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:ScholarAssignmentsViewModel"
             Title="Assign Scholars">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Assign a READS Scholar" Style="{StaticResource SectionTitle}" />
                    <Label Text="The Scholar will see the Dean, Chairperson and Faculty of the department you choose."
                           FontSize="13" TextColor="{StaticResource Gray600}" />

                    <Label Text="READS Scholar" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker Title="Choose a READS Scholar" ItemsSource="{Binding ScholarLabels}"
                                SelectedItem="{Binding SelectedScholarLabel}"
                                TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                    </Border>
                    <Label Text="There are no READS Scholars yet." IsVisible="{Binding HasNoScholars}"
                           FontSize="12" TextColor="{StaticResource Gray600}" />

                    <Label Text="School" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker Title="Choose school" ItemsSource="{Binding Schools}"
                                SelectedItem="{Binding SelectedSchool}" IsEnabled="{Binding HasScholarSelected}"
                                TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                    </Border>

                    <Label Text="Department" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker Title="Choose school first, then department" ItemsSource="{Binding Departments}"
                                SelectedItem="{Binding SelectedDepartment}" IsEnabled="{Binding HasSchool}"
                                TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                    </Border>

                    <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorRed}" FontSize="13" />
                    </Border>
                    <Border IsVisible="{Binding HasSuccess}" BackgroundColor="{StaticResource GoldSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding SuccessMessage}" FontSize="13" />
                    </Border>

                    <Button Text="Save assignment" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                    <Button Text="Remove assignment" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotBusy}"
                            Style="{StaticResource OutlineButton}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Current assignments" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Assignments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AssignmentRow">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Assignment}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
