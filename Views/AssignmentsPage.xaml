<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.AssignmentsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:ScholarAssignmentsViewModel"
             Title="Assign READS">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Assign a READS" Style="{StaticResource SectionTitle}" />
                    <Label Text="A READS monitors the classes of every department of one school and sees that school's Dean, Chairpersons and Faculty. A READS cannot be assigned to the school they study in. If the READS already has a school, you only choose a building and a floor in the next section."
                           FontSize="13" TextColor="{StaticResource Gray600}" />

                    <Label Text="READS" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker Title="Choose a READS" ItemsSource="{Binding ScholarLabels}"
                                SelectedItem="{Binding SelectedScholarLabel}"
                                TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                    </Border>
                    <Label Text="There are no READS yet." IsVisible="{Binding HasNoScholars}"
                           FontSize="12" TextColor="{StaticResource Gray600}" />

                    <Label Text="{Binding AssignedSchoolText}" IsVisible="{Binding ShowAssignedSchool}"
                           FontSize="13" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                    <Button Text="Change school" Command="{Binding ChangeSchoolCommand}" IsVisible="{Binding ShowAssignedSchool}"
                            Style="{StaticResource OutlineButton}" />

                    <VerticalStackLayout Spacing="12" IsVisible="{Binding ShowSchoolPicker}">
                        <Label Text="School" Style="{StaticResource SectionTitle}" FontSize="13" />
                        <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                            <Picker Title="Choose school" ItemsSource="{Binding Schools}"
                                    SelectedItem="{Binding SelectedSchool}" IsEnabled="{Binding HasScholarSelected}"
                                    TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                        </Border>
                        <Label Text="{Binding OwnSchoolText}" FontSize="12" TextColor="{StaticResource Gray600}" />

                        <Button Text="Save school" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" />
                        <Button Text="Remove school" Command="{Binding ClearCommand}" IsEnabled="{Binding IsNotBusy}"
                                Style="{StaticResource OutlineButton}" />
                        <Button Text="Cancel" Command="{Binding CancelChangeSchoolCommand}" IsVisible="{Binding IsChangingSchool}"
                                Style="{StaticResource OutlineButton}" />
                    </VerticalStackLayout>

                    <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorRed}" FontSize="13" />
                    </Border>
                    <Border IsVisible="{Binding HasSuccess}" BackgroundColor="{StaticResource GoldSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding SuccessMessage}" FontSize="13" />
                    </Border>

                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Classes and floor to check" Style="{StaticResource SectionTitle}" />
                    <Label Text="Choose the READS above, then a building and a floor. Each class has two checks: the first check (5 minutes after it starts) and the end check (opens 15 minutes before it ends, so one READS can walk a whole floor). A check can be ticked when it falls inside the READS' Work Time. If a class runs past the end of the Work Time, tick only the first check here and give the end check to the READS whose Work Time starts there. The READS sees the classes (with the floor) on the Attendance tab."
                           FontSize="13" TextColor="{StaticResource Gray600}" />
                    <Label Text="{Binding VacantText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" IsVisible="{Binding HasScholarSelected}" />

                    <Label Text="Building" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker Title="Choose building" ItemsSource="{Binding Buildings}"
                                SelectedItem="{Binding SelectedBuilding}" IsEnabled="{Binding HasScholarSelected}"
                                TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                    </Border>

                    <Label Text="Floor" Style="{StaticResource SectionTitle}" FontSize="13" />
                    <Border Stroke="{StaticResource Gray200}" Padding="12,0">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <Picker Title="Choose floor" ItemsSource="{Binding Floors}"
                                SelectedItem="{Binding SelectedFloor}" IsEnabled="{Binding HasScholarSelected}"
                                TextColor="{StaticResource InkDark}" TitleColor="#8FA096" />
                    </Border>

                    <Label Text="{Binding ClassesMessage}" FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasClassesMessage}" />

                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Classes}" IsVisible="{Binding HasClasses}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ClassPick">
                                <VerticalStackLayout Spacing="2" Padding="0,8">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                    <HorizontalStackLayout Spacing="4">
                                        <CheckBox IsChecked="{Binding StartSelected, Mode=TwoWay}" IsEnabled="{Binding CanStart}" />
                                        <Label Text="First check" VerticalOptions="Center" FontSize="13" Margin="0,0,16,0" />
                                        <CheckBox IsChecked="{Binding EndSelected, Mode=TwoWay}" IsEnabled="{Binding CanEnd}" />
                                        <Label Text="End check" VerticalOptions="Center" FontSize="13" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Note}" FontSize="12" TextColor="{StaticResource ErrorRed}" IsVisible="{Binding HasNote}" />
                                    <BoxView HeightRequest="1" Color="{StaticResource Gray200}" Margin="0,6,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding HasClasses}">
                        <Button Grid.Column="0" Text="Tick all" Style="{StaticResource OutlineButton}" Command="{Binding SelectAllClassesCommand}" />
                        <Button Grid.Column="1" Text="Untick all" Style="{StaticResource OutlineButton}" Command="{Binding ClearClassesCommand}" />
                    </Grid>
                    <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorRed}" FontSize="13" />
                    </Border>
                    <Border IsVisible="{Binding HasSuccess}" BackgroundColor="{StaticResource GoldSoft}"
                            StrokeThickness="0" Padding="12,10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                        <Label Text="{Binding SuccessMessage}" FontSize="13" />
                    </Border>
                    <Button Text="Save assignment" Command="{Binding SaveClassesCommand}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding CanAssignFloor}" />
                    <Button Text="Remove assignment" Command="{Binding RemoveFloorCommand}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding CanAssignFloor}"
                            Style="{StaticResource OutlineButton}" />
                    <Label Text="Save assignment gives the ticked checks of this floor to the READS. Remove assignment takes every class of this floor off the READS' list." FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding CanAssignFloor}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Current assignments" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Assignments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:AssignmentRow">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
                                    <Label Text="{Binding Assignment}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
