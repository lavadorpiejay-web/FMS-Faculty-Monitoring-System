<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="FacultyMonitoring.Views.AttendanceLogPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:FacultyMonitoring.Controls"
             xmlns:vm="clr-namespace:FacultyMonitoring.ViewModels"
             xmlns:models="clr-namespace:FacultyMonitoring.Models"
             x:DataType="vm:AttendanceLogViewModel"
             Title="Attendance">
    <controls:DraggableScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <VerticalStackLayout Spacing="4">
                <Label Text="Attendance logging" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                <Label Text="{Binding ClockText}" FontSize="13" TextColor="{StaticResource Gray600}" />
                <Label Text="{Binding MonitoringText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                <Label Text="{Binding FloorsText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" IsVisible="{Binding HasFloors}" />
                <Label Text="Your classes for today are listed below, the ones you can check now first. Check each class twice: 5 minutes after it starts and in the last 15 minutes before it ends. Tap In the Room or Not in the Room for the person who handles the subject."
                       FontSize="13" TextColor="{StaticResource Gray600}" />
            </VerticalStackLayout>

            <controls:Banners />

            <Border Style="{StaticResource Card}" IsVisible="{Binding IsDebug}" BackgroundColor="{StaticResource GoldSoft}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Test clock (debug builds only)" Style="{StaticResource SectionTitle}" />
                    <Label Text="Pretend it is a day and time that falls inside a duty window, to try logging at any hour."
                           FontSize="13" TextColor="{StaticResource Gray600}" />
                    <HorizontalStackLayout Spacing="10">
                        <Switch IsToggled="{Binding UseTestClock, Mode=TwoWay}" VerticalOptions="Center" />
                        <Label Text="Use test clock" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <controls:LabeledPicker Caption="Test day" Title="Choose day" ItemsSource="{Binding Days}" SelectedItem="{Binding TestDay, Mode=TwoWay}" />
                    <controls:LabeledPicker Caption="Test time" Title="Choose time" ItemsSource="{Binding Times}" SelectedItem="{Binding TestTime, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Classes to check today" Style="{StaticResource SectionTitle}" />
                    <Label Text="{Binding EmptyText}" IsVisible="{Binding HasNoClasses}"
                           FontSize="13" TextColor="{StaticResource Gray600}" />
                    <Label Text="{Binding ProgressText}" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" IsVisible="{Binding HasClasses}" />
                    <controls:LabeledEntry Caption="Notes for the check (optional)" Placeholder="Anything IMS should know, for example why you think the faculty is not in the room" Text="{Binding CheckNotes, Mode=TwoWay}" IsVisible="{Binding HasClasses}" />
                    <Label Text="A class stays in the list all day. When both checks are done it is marked Finished with its result." FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasClasses}" />
                    <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:MonitorRow">
                                <Border Style="{StaticResource Card}" Padding="14" BackgroundColor="{StaticResource Ivory}">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="{Binding FloorText}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource ForestMid}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Grid.Column="0" Text="{Binding Room}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                                            <Label Grid.Column="1" Text="{Binding Time}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding Subject}" FontSize="14" />
                                        <Label Text="{Binding PersonText}" FontSize="15" FontAttributes="Bold" />
                                        <Label Text="{Binding PartText}" FontSize="12" FontAttributes="Italic" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasPartText}" />
                                        <Label Text="{Binding State}" FontSize="12" TextColor="{StaticResource ForestMid}" />
                                        <Label Text="{Binding Notes, StringFormat='Notes: {0}'}" FontSize="12" TextColor="{StaticResource Gray600}" IsVisible="{Binding HasNotes}" />

                                        <VerticalStackLayout Spacing="6" IsVisible="{Binding CanLog}">
                                            <Label Text="{Binding CheckCaption}" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Button Grid.Column="0" Text="In the Room" HeightRequest="52" FontSize="15" FontAttributes="Bold"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceLogViewModel}}, Path=InRoomCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="1" Text="Not in the Room" HeightRequest="52" FontSize="15" FontAttributes="Bold"
                                                        BackgroundColor="{StaticResource ErrorRed}" TextColor="White"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AttendanceLogViewModel}}, Path=NotInRoomCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>

                                        <HorizontalStackLayout Spacing="6" IsVisible="{Binding IsFinished}">
                                            <Label Text="✔ Finished:" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource DeepGreen}" />
                                            <Label Text="{Binding Result}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ForestMid}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Report an irregularity" Style="{StaticResource SectionTitle}" />
                    <Label Text="For example a faculty member who is not in the assigned room, or a class held in a room that was not approved."
                           FontSize="13" TextColor="{StaticResource Gray600}" />
                    <controls:LabeledPicker Caption="Class" Title="Choose a class from the list above" ItemsSource="{Binding ReportClassLabels}" SelectedItem="{Binding SelectedReportClass, Mode=TwoWay}" />
                    <controls:LabeledPicker Caption="What did you observe?" Title="Choose" ItemsSource="{Binding ReportKinds}" SelectedItem="{Binding SelectedReportKind, Mode=TwoWay}" />
                    <controls:LabeledPicker Caption="Room where the class was held" Title="Choose the room you saw" ItemsSource="{Binding RoomLabels}"
                                            SelectedItem="{Binding SelectedObservedRoom, Mode=TwoWay}" IsVisible="{Binding AskRoom}" />
                    <controls:LabeledEntry Caption="Notes (optional)" Placeholder="Anything IMS should know" Text="{Binding Notes, Mode=TwoWay}" />
                    <Button Text="Submit report" Command="{Binding ReportCommand}" IsEnabled="{Binding IsNotBusy}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="My recent entries" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding RecentLogs}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ListRow">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" />
                                    <Label Text="{Binding Detail}" FontSize="12" TextColor="{StaticResource Gray600}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </controls:DraggableScrollView>
</ContentPage>
