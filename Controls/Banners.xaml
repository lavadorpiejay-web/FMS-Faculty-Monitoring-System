<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="FacultyMonitoring.Controls.Banners"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- Shows the ErrorMessage / SuccessMessage of the page's view model (PageViewModelBase). -->
    <VerticalStackLayout Spacing="8">
        <Border IsVisible="{Binding HasError}" BackgroundColor="{StaticResource ErrorSoft}" StrokeThickness="0" Padding="12,10">
            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorRed}" FontSize="13" />
        </Border>
        <Border IsVisible="{Binding HasSuccess}" BackgroundColor="{StaticResource GoldSoft}" StrokeThickness="0" Padding="12,10">
            <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
            <Label Text="{Binding SuccessMessage}" FontSize="13" />
        </Border>
    </VerticalStackLayout>
</ContentView>
